# Пример настроек. Это безопасный шаблон — здесь нет настоящих секретов.
# Свой файл создаётся так:  cp .env.example .env
# Файл .env находится в .gitignore и НЕ должен попадать в репозиторий.

# Название сервиса (показывается в / и /version)
APP_NAME="CCTV Monitor"

# Автор (показывается в /version)
APP_AUTHOR="Ваше Имя"

# Сколько дней хранить записи: целое число от 1 до 3650.
# Используется в расчёте места под архив (/storage/estimate, /storage/required)
RETENTION_DAYS=14

# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
